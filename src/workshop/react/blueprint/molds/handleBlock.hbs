
{{#each operations}}
const {{this.action}} = async params => {
    setLoading(true)
    const response = await {{{this.request}}}
    setLoading(false)
    if({{{../responseSuccess}}}){
        refresh()
    }
}

{{/each}}

{{#each functionButtons}}
const {{this.action}} = () => {
    const params = {}
    let fetching = false
    Modal.confirm({
        title: '确认',
        centered: true,
        content: '确认{{this.btn}}吗？',
        onOk: async () => {
            if (fetching) {
                return
            }
            fetching = true
            const response = await {{{this.request}}}
            if({{{../responseSuccess}}}){
                refresh()
            }
        }
    })
}

{{/each}}

{{#if hasTabs}}
const onTabChange = key => {
    setActiveKey(key)
    {{#if hasFormItems}}form.resetFields(){{/if}}
    {{#if hasRowSelection}}setSelectedRows([]){{/if}}
    setSearch({ pageNo: 1, pageSize: 10, type: key })
}
{{/if}}

{{#if hasExpandable}}
const onExpand = async (expanded, record) => {
    if (expanded) {
        setExpandedRowKeys(prev=>[...prev, record[rowKey]])
    } else {
        setExpandedRowKeys(prev=>prev.filter(item => item !== record[rowKey]))
    }
}

const expandedRowRender = record => (<div>自定义渲染</div>)

{{/if}}


{{#if hasImageColumn}}
const showImg = (record, dataIndex) => {
    const list = record[dataIndex]?.split(',') ?? []
    const isUrl=list.some(item=>item.startsWith('http'))
    if(isUrl){
        setImg({ list, visible: true })
    }else{
        //自行解决图片路径问题
    }
}

{{/if}}

let fetching = false
const modalSubmit = async params => {
    const requestMap={
    {{#each operations}}
        {{this.action}}:()=> {{this.request}},
    {{/each}}
    }
    if (fetching) return
    fetching = true
    const response = await requestMap[modal.type]?.()
    fetching = false
    if({{{responseSuccess}}}){
        setModal({ visible: false })
        refresh()
    }
}